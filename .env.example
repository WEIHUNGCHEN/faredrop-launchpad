# Supabase project the browser client talks to.
# The publishable key (sb_publishable_*) is the browser-safe, RLS-gated key —
# it replaces what Supabase used to call the anon key. Never put a secret
# (sb_secret_* / service_role) key in a VITE_ variable: Vite inlines these
# into the client bundle.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
